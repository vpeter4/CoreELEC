+int aml_axis_value(AML_DISPLAY_AXIS_PARAM param)
+{
+  std::string axis;
+  int value[8];
+
+  SysfsUtils::GetString("/sys/class/display/axis", axis);
+  sscanf(axis.c_str(), "%d %d %d %d %d %d %d %d", &value[0], &value[1], &value[2], &value[3], &value[4], &value[5], &value[6], &value[7]);
+
+  return value[param];
+}
