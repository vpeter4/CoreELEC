-  /// std::string a{"a\0b\n", 4};
-  /// EXPECT_STREQ("6100620a", kodi::tools::StringUtils::ToHexadecimal(a).c_str());
-  /// std::string nul{"\0", 1};
-  /// EXPECT_STREQ("00", kodi::tools::StringUtils::ToHexadecimal(nul).c_str());
-  /// std::string ff{"\xFF", 1};
