-  inline static int AsciiXDigitValue(char chr) // locale independent
-  {
-    int v = AsciiDigitValue(chr);
-    if (v >= 0)
-      return v;
-    if (chr >= 'a' && chr <= 'f')
-      return chr - 'a' + 10;
-    if (chr >= 'A' && chr <= 'F')
-      return chr - 'A' + 10;
-
-    return -1;
-  }
