+    CLog::Log(LOGERROR, "dumpfile_write: wtf ? buf is null, bufsiz(%d)", bufsiz);
+    return;
+  }
+
+  if (para->dumpdemux && para->dumpfile != -1)
+    write(para->dumpfile, buf, bufsiz);
+}
