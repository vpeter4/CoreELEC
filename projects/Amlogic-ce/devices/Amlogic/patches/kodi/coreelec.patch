-  ///                    given further on return
-  /// @return The changed string
-  ///
-  inline static std::string& RemoveDuplicatedSpacesAndTabs(std::string& str)
-  {
-    std::string::iterator it = str.begin();
-    bool onSpace = false;
-    while (it != str.end())
-    {
-      if (*it == '\t')
-        *it = ' ';
-
-      if (*it == ' ')
-      {
-        if (onSpace)
-        {
-          it = str.erase(it);
-          continue;
-        }
-        else
-          onSpace = true;
-      }
-      else
-        onSpace = false;
-
-      ++it;
-    }
-    return str;
-  }
