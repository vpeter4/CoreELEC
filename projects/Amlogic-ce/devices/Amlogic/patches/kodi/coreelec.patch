-  inline static int compareWchar(const void* a, const void* b)
-  {
-    if (*static_cast<const wchar_t*>(a) < *static_cast<const wchar_t*>(b))
-      return -1;
-    else if (*static_cast<const wchar_t*>(a) > *static_cast<const wchar_t*>(b))
-      return 1;
-    return 0;
-  }
