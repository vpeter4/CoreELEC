-  /// ~~~~~~~~~~~~~
-  ///
-  inline static std::string ToHexadecimal(const std::string& in)
-  {
-    std::ostringstream ss;
-    ss << std::hex;
-    for (unsigned char ch : in)
-    {
-      ss << std::setw(2) << std::setfill('0') << static_cast<unsigned long>(ch);
-    }
-    return ss.str();
-  }
