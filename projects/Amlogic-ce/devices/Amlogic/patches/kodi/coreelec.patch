-  inline static wchar_t toupperUnicode(const wchar_t& c)
-  {
-    wchar_t* p =
-        static_cast<wchar_t*>(bsearch(&c, unicode_lowers, sizeof(unicode_lowers) / sizeof(wchar_t),
-                                      sizeof(wchar_t), compareWchar));
-    if (p)
-      return *(unicode_uppers + (p - unicode_lowers));
-
-    return c;
-  }
